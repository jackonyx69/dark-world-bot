{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./client/src/*"],
      "@workspace/api-client-react": ["./packages/api-client-react/src/index.ts"],
      "@workspace/api-zod": ["./packages/api-zod/src/index.ts"],
      "@workspace/db": ["./packages/db/src/index.ts"]
    }
  },
  "include": ["server.ts", "app.ts", "routes/**/*", "middleware/**/*", "utils/**/*", "models/**/*", "packages/**/*", "client/src/**/*"]
}
